---
import { Icon } from 'astro-icon/components'
import { PANEL_URL, PRECIO_TEXTO, CONTACTO_FALLBACK } from '../config'

/**
 * Form de solicitud. Al enviar:
 *   1. POST a /api/publico/solicitud del panel.
 *   2. El panel guarda el lead y crea el preapproval de Mercado Pago.
 *   3. Redirige al link de pago.
 *
 * Si Mercado Pago falla, el panel devuelve 503 con el lead ya guardado. En ese
 * caso mostramos el canal de contacto directo, porque el interesado no tiene
 * que quedarse sin salida.
 */
---

<section id="solicitar" class="seccion">
  <div class="contenedor">
    <div class="grid gap-12 lg:grid-cols-[1fr_minmax(0,600px)] lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-28">
        <h2 class="titulo-seccion revelar">Empezá ahora.</h2>
        <p class="bajada mt-5 revelar" style="transition-delay: 60ms">
          Completás estos datos, pagás la primera cuota y dentro de 48 horas lo tenés funcionando
          con tu cartera adentro.
        </p>
        <p class="revelar mt-8 text-sm text-slate-400" style="transition-delay: 120ms">
          ¿Preferís preguntar antes?
          <a href={CONTACTO_FALLBACK.href} class="text-naranja-400 underline underline-offset-4 hover:text-naranja-300">
            {CONTACTO_FALLBACK.label}
          </a>
        </p>
      </div>

      <form id="form-solicitud" class="panel revelar p-6 lg:p-8" style="transition-delay: 100ms" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="nombre" class="campo-label">Nombre y apellido</label>
            <input type="text" id="nombre" name="nombre" required autocomplete="name" class="campo" placeholder="Martín Etcheverry" />
          </div>
          <div>
            <label for="telefono" class="campo-label">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" required autocomplete="tel" class="campo" placeholder="11 4728 5510" />
          </div>
          <div>
            <label for="email" class="campo-label">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="campo" placeholder="martin@tuestudio.com.ar" />
          </div>
          <div>
            <label for="cuit" class="campo-label">CUIT</label>
            <input
              type="text"
              id="cuit"
              name="cuit"
              required
              inputmode="numeric"
              class="campo font-mono"
              placeholder="20 12345678 9"
            />
          </div>
          <div>
            <label for="empresa" class="campo-label">
              Nombre del estudio <span class="font-normal text-slate-500">(opcional)</span>
            </label>
            <input type="text" id="empresa" name="empresa" autocomplete="organization" class="campo" placeholder="Lobo Seguros" />
          </div>
          <div>
            <label for="cantidad_polizas" class="campo-label">
              Pólizas activas <span class="font-normal text-slate-500">(aproximado)</span>
            </label>
            <select id="cantidad_polizas" name="cantidad_polizas" class="campo">
              <option value="">Elegí una opción</option>
              <option value="0-50">Hasta 50</option>
              <option value="51-200">Entre 51 y 200</option>
              <option value="201-500">Entre 201 y 500</option>
              <option value="501+">Más de 500</option>
            </select>
          </div>
        </div>

        <div class="mt-5">
          <label for="mensaje" class="campo-label">
            Algo que quieras contarme <span class="font-normal text-slate-500">(opcional)</span>
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="3"
            class="campo resize-none"
            placeholder="De qué sistema venís, o qué necesitás resolver primero"></textarea>
        </div>

        <!-- Honeypot: invisible para personas, tentador para bots. -->
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label for="_website">No completar</label>
          <input type="text" id="_website" name="_website" tabindex="-1" autocomplete="off" />
        </div>

        <p
          id="form-error"
          class="mt-5 hidden rounded-control border border-naranja-500/40 bg-naranja-500/10 px-3.5 py-3 text-sm text-naranja-300"
          role="alert"
        >
        </p>

        <button type="submit" id="form-enviar" class="btn-primario mt-6 w-full disabled:opacity-60">
          <span id="form-enviar-texto">Ir al pago de <span data-precio>{PRECIO_TEXTO}</span></span>
          <Icon id="form-enviar-icono" name="ph:arrow-right-bold" class="h-4 w-4" />
        </button>

        <p class="mt-4 text-sm text-slate-500">
          Te contactamos por email o WhatsApp para coordinar la puesta en marcha. Tus datos no se
          comparten con nadie.
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ PANEL_URL, PRECIO_TEXTO, FALLBACK: CONTACTO_FALLBACK }}>
  const form = document.getElementById('form-solicitud')
  const boton = document.getElementById('form-enviar')
  const textoBoton = document.getElementById('form-enviar-texto')
  const cajaError = document.getElementById('form-error')

  /**
   * El importe del botón NO sale de una constante congelada al compilar: el
   * script de la base pudo haberlo reemplazado por el que manda el panel, que
   * es el que realmente se va a cobrar. Si `restaurar()` usara la constante,
   * un error del envío dejaría el botón anunciando un precio y la tarjeta de
   * arriba otro.
   *
   * Se lee de `documentElement.dataset`, no del span de adentro del botón:
   * `restaurar()` reescribe ese contenido, así que a partir del segundo error
   * el span ya no estaría y volveríamos al número viejo.
   */
  const precioVivo = () => document.documentElement.dataset.precioTexto || PRECIO_TEXTO
  const textoInicial = () => `Ir al pago de ${precioVivo()}`

  if (form && boton && textoBoton && cajaError) {
    const mostrarError = (mensaje, ofrecerContacto) => {
      cajaError.textContent = mensaje
      if (ofrecerContacto) {
        const enlace = document.createElement('a')
        enlace.href = FALLBACK.href
        enlace.textContent = ` ${FALLBACK.label}.`
        enlace.className = 'underline underline-offset-4'
        cajaError.appendChild(enlace)
      }
      cajaError.classList.remove('hidden')
    }

    const restaurar = () => {
      boton.disabled = false
      textoBoton.textContent = textoInicial()
    }

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault()
      cajaError.classList.add('hidden')
      cajaError.textContent = ''

      // Validación del navegador primero, para no gastar un intento del rate limit.
      if (!form.checkValidity()) {
        form.reportValidity()
        return
      }

      const cuit = String(new FormData(form).get('cuit') ?? '').replace(/\D/g, '')
      if (cuit.length !== 11) {
        mostrarError('El CUIT tiene que tener 11 dígitos.', false)
        document.getElementById('cuit')?.focus()
        return
      }

      boton.disabled = true
      textoBoton.textContent = 'Procesando'

      const datos = {}
      for (const [clave, valor] of new FormData(form).entries()) {
        datos[clave] = String(valor)
      }

      try {
        const respuesta = await fetch(`${PANEL_URL}/api/publico/solicitud`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        })
        const cuerpo = await respuesta.json().catch(() => null)

        if (respuesta.ok && cuerpo?.data?.mp_link) {
          window.location.href = cuerpo.data.mp_link
          return
        }

        // 503: el lead quedó guardado pero no hay link de pago.
        if (respuesta.status === 503) {
          mostrarError(
            cuerpo?.error ?? 'No pudimos generar el link de pago. Ya tenemos tus datos y te contactamos.',
            true,
          )
          textoBoton.textContent = 'Datos enviados'
          return
        }

        mostrarError(cuerpo?.error ?? 'No pudimos procesar la solicitud.', true)
        restaurar()
      } catch {
        mostrarError('No pudimos conectarnos. Revisá tu conexión e intentá de nuevo, o', true)
        restaurar()
      }
    })
  }
</script>
