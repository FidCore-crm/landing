---
import { Icon } from 'astro-icon/components'

/**
 * Las funciones del sistema, en tarjetas.
 *
 * La primera versión de esta sección era un inventario en prosa: 12 bloques y
 * ~40 funciones, cada una con una o dos frases. Tenía todo, pero había que
 * leerlo. Nahuel trajo adminse.com.ar como referencia —«no se escribe tanto,
 * se detalla las herramientas con pequeñas explicaciones, y el uso de las
 * tarjetas con íconos hace más visible cada herramienta»— y tiene razón: ahí
 * cada módulo es una tarjeta con un ícono y dos o tres palabras.
 *
 * Lo que se conserva de la versión larga: el inventario completo. Un PAS que
 * está evaluando quiere ver TODO lo que compra. Lo que cambia es el formato —
 * el resumen de cada área en una línea, y las funciones como renglones de tres
 * o cuatro palabras en vez de frases.
 *
 * REGLA: cada función de esta lista existe y se verificó contra el código del
 * CRM. Si una se saca del CRM, se saca de acá el mismo día.
 *
 * Trampas conocidas del copy:
 *   · El agente NO extrae la prima. Extrae la SUMA ASEGURADA.
 *   · No prometer «fusionar duplicados»: no entran duplicados, lo impide la
 *     base con índices únicos sobre el DNI normalizado.
 */

const areas = [
  {
    icono: 'ph:sparkle',
    titulo: 'Cargar una póliza',
    resumen: 'El PDF se carga solo',
    items: [
      'Importador con IA',
      'Avisa de lo que duda',
      'Importación masiva por planilla',
      'Tus propios catálogos',
      'Carga manual',
      'No entran duplicados',
    ],
  },
  {
    icono: 'ph:file-text',
    titulo: 'La póliza y su ciclo',
    resumen: 'De la emisión a la baja',
    items: [
      'Endosos con su detalle',
      'Renovaciones encadenadas',
      'Comparador de renovaciones',
      'Anulación y cancelación',
      'Cupones de pago en efectivo',
      'Campos del riesgo por ramo',
    ],
  },
  {
    icono: 'ph:bell-ringing',
    titulo: 'Vencimientos',
    resumen: 'Ninguno se te pasa',
    items: [
      'Tablero a 7, 15 y 30 días',
      'Avisos automáticos',
      'Calendario con tareas',
    ],
  },
  {
    icono: 'ph:warning-octagon',
    titulo: 'Siniestros',
    resumen: 'De la denuncia al cierre',
    items: [
      'Número de caso propio',
      'Estado y bitácora',
      'Formulario por tipo de caso',
      'Reclamos de terceros',
      'Documentación y fotos',
      'Papelera con recuperación',
    ],
  },
  {
    icono: 'ph:user-circle',
    titulo: 'Portal del asegurado',
    resumen: 'Tu cliente se maneja solo',
    items: [
      'Sin contraseña',
      'Sus pólizas y sus papeles',
      'Sigue su siniestro',
      'Denuncia pre-completada',
      'Asistencia 24 horas',
      'Se instala como app',
    ],
  },
  {
    icono: 'ph:users',
    titulo: 'Clientes',
    resumen: 'Su historia completa',
    items: [
      'Ficha con todo su recorrido',
      'Personas físicas y jurídicas',
      'Registro de llamadas',
      'Búsqueda global',
    ],
  },
  {
    icono: 'ph:target',
    titulo: 'Comercial',
    resumen: 'Lo que todavía no es póliza',
    items: [
      'Leads y oportunidades',
      'Cotizaciones en PDF',
      'Embudo de conversión',
      'Formulario web propio',
    ],
  },
  {
    icono: 'ph:percent',
    titulo: 'Comerciales y comisiones',
    resumen: 'Quién vendió y cuánto cobra',
    items: [
      'Reglas por comercial',
      'Liquidación mensual',
      'Portal del comercial',
      'Planillas de las compañías',
    ],
  },
  {
    icono: 'ph:check-square',
    titulo: 'El día a día',
    resumen: 'Lo de todas las mañanas',
    items: [
      'Tareas con recurrencia',
      'Notificaciones',
      'Contadores en vivo',
      'Correos con tus plantillas',
    ],
