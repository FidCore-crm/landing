---
import { Icon } from 'astro-icon/components'

/**
 * Bento asimétrico: 5 celdas para 5 features, sin celdas vacías.
 * La celda grande es el importador IA porque es el diferencial real.
 *
 * Las features de infraestructura (backups, actualizaciones, soporte) no están
 * acá: viven en la lista de lo que incluye el precio, que es donde el PAS las
 * busca.
 */

const secundarias = [
  {
    icono: 'ph:bell-ringing',
    titulo: 'Renovaciones que te avisan',
    texto:
      'El sistema te marca qué vence y cuándo. La renovada se vincula con la anterior, así no perdés el historial.',
  },
  {
    icono: 'ph:warning-octagon',
    titulo: 'Siniestros con seguimiento',
    texto:
      'Cada caso con su número interno, sus estados y el registro de quién hizo qué. Si el asegurado llama, sabés dónde está parado.',
  },
  {
    icono: 'ph:user-circle',
    titulo: 'Portal del asegurado',
    texto:
      'Tu cliente entra, ve sus pólizas, descarga los documentos y denuncia un siniestro. Menos llamadas para pedirte lo mismo.',
  },
  {
    icono: 'ph:percent',
    titulo: 'Comisiones calculadas',
    texto:
      'Cargás tus reglas por compañía y ramo una vez. Después el sistema calcula y vos controlás lo que te liquidaron.',
  },
]

/**
 * Campos reales que extrae el agente, tomados de `DatosExtraidosPoliza` en
 * src/lib/agente-pdf/types.ts del CRM. NO agregar campos sin verificarlos ahí.
 * En una versión anterior decía "Prima", que el sistema no extrae: extrae suma
 * asegurada, que es otra cosa.
 */
const camposExtraidos = [
  'Asegurado',
  'Tomador',
  'DNI o CUIT',
  'Domicilio',
  'Compañía',
  'Ramo',
  'Cobertura',
  'Número de póliza',
  'Vigencia',
  'Moneda',
  'Suma asegurada',
  'Medio de pago',
  'Refacturación',
  'Datos del riesgo',
]
---

<section class="seccion">
  <div class="contenedor">
    <h2 class="titulo-seccion max-w-3xl revelar">Lo que hace, dicho sin vueltas.</h2>

    <!--
      Bento de 5 celdas para 5 features, sin celdas vacías.
      La celda de IA ocupa 4 columnas y 2 filas: es la más importante y así
      tiene lugar para los chips sin quedar estirada con espacio muerto.
      Después el ritmo cambia a dos celdas de 3 columnas.
    -->
    <div class="mt-12 grid gap-4 lg:grid-cols-6">
      <!-- Celda grande: el diferencial. Fondo con gradiente de marca. -->
      <article
        class="grano revelar relative overflow-hidden rounded-panel p-7 lg:col-span-4 lg:row-span-2 lg:p-9"
        style="background-image: radial-gradient(130% 120% at 8% 0%, rgba(42,74,122,0.75) 0%, rgba(18,35,65,0.9) 45%, rgba(10,22,40,0.85) 100%);
               box-shadow: inset 0 0 0 1px rgba(255,255,255,0.09), inset 0 1px 0 rgba(255,140,60,0.28), 0 34px 68px -30px rgba(3,8,18,0.95)"
      >
        <div class="relative">
          <Icon name="ph:file-arrow-up" class="h-8 w-8 text-naranja-500" />
          <h3 class="titulo mt-5 text-d-sm">Arrastrás el PDF. Ya está cargada.</h3>
          <p class="mt-4 max-w-lectura text-base text-slate-300">
            La IA lee la póliza y completa el formulario. Vos revisás y confirmás. Si el PDF viene
            mal escaneado o preferís no usar IA, cargás a mano como siempre.
          </p>

          <p class="mt-7 font-mono text-2xs uppercase tracking-[0.14em] text-slate-500">
            Datos que reconoce
          </p>
          <ul class="mt-3 flex flex-wrap gap-x-2 gap-y-2">
            {
              camposExtraidos.map((campo) => (
                <li class="rounded-pill border border-white/10 bg-navy-950/50 px-2.5 py-1 font-mono text-2xs text-slate-300">
                  {campo}
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!--
        Las dos primeras van al lado de la celda grande (2 columnas cada una),
        las dos últimas abajo y más anchas (3 columnas). El cambio de ancho es
        lo que le da ritmo a la grilla en vez de repetir tarjetas iguales.
      -->
      {
        secundarias.map((f, i) => (
          <article
            class:list={[
              'panel-hover revelar p-6',
              i < 2 ? 'lg:col-span-2' : 'lg:col-span-3',
            ]}
            style={`transition-delay: ${80 + i * 60}ms`}
          >
            <div class="flex items-start gap-3.5">
              <Icon name={f.icono} class="mt-0.5 h-5 w-5 shrink-0 text-naranja-500" />
              <div>
                <h3 class="font-display text-lg font-semibold text-white ancho-100">{f.titulo}</h3>
                <p class="mt-1.5 text-sm text-slate-400">{f.texto}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
