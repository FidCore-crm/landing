---
// Nav simple, sticky, con CTA prominente.
---

<nav class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-md bg-navy-900 flex items-center justify-center">
          <span class="text-white font-bold text-sm">F</span>
        </div>
        <span class="font-semibold text-slate-900 tracking-tight">FidCore CRM</span>
      </a>

      <div class="hidden md:flex items-center gap-6 text-sm">
        <a href="#features" class="text-slate-600 hover:text-slate-900">Funcionalidades</a>
        <a href="#precio" class="text-slate-600 hover:text-slate-900">Precio</a>
        <a href="#contacto" class="text-slate-600 hover:text-slate-900">Contacto</a>
      </div>

      <a
        href="#contacto"
        class="inline-flex items-center gap-1.5 bg-navy-900 hover:bg-navy-800 text-white text-sm font-medium px-3.5 py-1.5 rounded-md transition-colors"
      >
        Empezar ahora
      </a>
    </div>
  </div>
</nav>
