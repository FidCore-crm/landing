      'Documentación y fotos',
      'Papelera con recuperación',
    ],
  },
  {
    icono: 'ph:user-circle',
    titulo: 'Portal del asegurado',
    resumen: 'Autogestión para tus clientes',
    items: [
      'Acceso sin contraseña',
      'Pólizas y documentación',
      'Seguimiento del siniestro',
      'Denuncia precargada',
