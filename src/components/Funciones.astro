      'Reglas por comercial',
      'Liquidación mensual',
      'Portal del comercial',
      'Planillas de las compañías',
    ],
  },
  {
    icono: 'ph:check-square',
    titulo: 'Operación diaria',
    resumen: 'Tareas y avisos',
    items: [
      'Tareas recurrentes',
      'Notificaciones',
