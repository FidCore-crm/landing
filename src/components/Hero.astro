---
import { Icon } from 'astro-icon/components'
import { CTA } from '../config'
import RedParticulas from './RedParticulas.astro'

/**
 * Portada. Fase 2 (13/11/2026): el PAS pidió un aspecto moderno como el de
 * adminse.com.ar, en los colores de FidCore. A la izquierda el texto; a la
 * derecha, tarjetas con avisos del sistema (datos de ejemplo) en cascada. De
 * fondo, una red de puntos conectados (RedParticulas). La F armada con
 * partículas se descartó: «queda exactamente igual que al de adminse».
 *
 *  - El H1 dice qué es, directo (pedido del PAS): quien llega tiene que
 *    saberlo antes de leer el lema.
 *  - El naranja sigue concentrado: el botón, media frase del titular y los
 *    nodos que laten en la red.
 *  - Las tarjetas sólo en pantallas anchas: en el teléfono alargaban la
 *    portada sin sumar.
 */

const avisos = [
  {
    icono: 'ph:sparkle-fill',
    titulo: 'Póliza cargada con IA',
    detalle: 'Automotores · Todo riesgo',
    cuando: 'ahora',
    lugar: 'left-[4%] top-[6%]',
    demora: '0s',
  },
  {
    icono: 'ph:calendar-check-fill',
    titulo: 'Vencimientos de la semana',
    detalle: '14 pólizas por renovar',
    cuando: 'hoy',
    lugar: 'right-0 top-[29%]',
    demora: '1.2s',
  },
  {
    icono: 'ph:shield-check-fill',
    titulo: 'Siniestro actualizado',
    detalle: 'Inspección aprobada',
    cuando: 'hace 5 min',
    lugar: 'left-0 top-[52%]',
    demora: '2.1s',
  },
  {
    icono: 'ph:percent-bold',
    titulo: 'Comisiones de octubre',
    detalle: 'Liquidación calculada',
    cuando: 'hace 1 h',
    lugar: 'right-[7%] top-[75%]',
    demora: '0.6s',
  },
]
---

<section class="relative isolate overflow-hidden">
  <!--
    Sin base opaca propia: el hero hereda el fondo del body y solo suma sus
    gradientes. Una base más oscura acá dejaba una costura horizontal visible
    donde terminaba la sección.
  -->
  <div
    class="absolute inset-0"
    style="background: radial-gradient(120% 130% at 88% 118%, #2A4A7A 0%, #1E3A5F 32%, rgba(10,22,40,0) 68%)"
    aria-hidden="true"
  >
  </div>
  <!-- Resplandor naranja muy tenue detrás de las tarjetas. -->
  <div
    class="absolute inset-0"
    style="background: radial-gradient(38% 45% at 74% 46%, rgba(255,106,0,0.10) 0%, rgba(10,22,40,0) 70%)"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(70% 55% at 12% 24%, rgba(42,74,122,0.4) 0%, rgba(10,22,40,0) 62%)"
    aria-hidden="true"
  >
  </div>
  <RedParticulas />

  <div class="contenedor relative pb-16 pt-16 lg:pb-24 lg:pt-20">
    <div class="grid items-center gap-6 lg:grid-cols-[1.08fr_0.92fr] lg:gap-10">
      <div>
        <p class="eyebrow revelar">Carga de pólizas con inteligencia artificial</p>

        <h1 class="mt-5 text-balance text-xl font-semibold text-slate-300 sm:text-2xl revelar" style="transition-delay: 45ms">
          Sistema de gestión para productores asesores de seguros
        </h1>
        <p class="titulo mt-5 text-d-md sm:text-d-lg revelar" style="transition-delay: 90ms">
          Toda tu cartera,
          <span class="inline-block text-naranja-500">en un solo sistema.</span>
        </p>

        <p class="bajada mt-7 revelar" style="transition-delay: 180ms">
          Pólizas, renovaciones, siniestros, cupones de pago, gestión comercial y comisiones,
          integrados. La inteligencia artificial carga las pólizas desde el PDF y tus asegurados
          consultan su documentación desde su propio portal.
        </p>

        <div
          class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center revelar"
          style="transition-delay: 270ms"
        >
          <a href={CTA.href} class="btn-primario">
            {CTA.texto}
            <Icon name="ph:arrow-right-bold" class="h-4 w-4" />
          </a>
          <a href="#producto" class="btn-secundario">Ver el sistema</a>
        </div>
      </div>

      <div class="relative hidden h-[480px] lg:block">
        {
          avisos.map((a) => (
            <div
              class:list={['aviso-flotante absolute flex', a.lugar]}
              style={`animation-delay: ${a.demora}`}
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-control bg-naranja-500/15 text-naranja-400">
                <Icon name={a.icono} class="h-[18px] w-[18px]" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-baseline justify-between gap-3">
                  <span class="whitespace-nowrap text-[13px] font-semibold text-white">{a.titulo}</span>
                  <span class="whitespace-nowrap font-mono text-2xs text-slate-500">{a.cuando}</span>
                </span>
                <span class="mt-0.5 block text-xs text-slate-400">{a.detalle}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Cierre inferior: filete que separa el hero sin cortar con una línea dura. -->
  <div class="filete absolute bottom-0 left-0 right-0" aria-hidden="true"></div>
</section>

<style>
  .aviso-flotante {
    @apply w-[268px] items-center gap-3 rounded-panel border border-white/10 px-3 py-2.5;
    background: rgba(13, 27, 49, 0.72);
    backdrop-filter: blur(10px);
    box-shadow: 0 18px 40px -18px rgba(3, 8, 18, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    animation: flotar 7s ease-in-out infinite;
  }
  @keyframes flotar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aviso-flotante {
      animation: none;
    }
  }
</style>
