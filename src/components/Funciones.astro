  {
    icono: 'ph:sparkle',
    titulo: 'Carga de pólizas',
    resumen: 'Desde el PDF o en forma masiva',
    items: [
      'Importador con inteligencia artificial',
      'Señala los datos a revisar',
      'Importación masiva desde planillas',
      'Catálogos propios',
      'Carga manual',
      'Control de duplicados',
    ],
  },
  {
    icono: 'ph:file-text',
