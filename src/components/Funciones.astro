---

<section id="funciones" class="seccion">
  <div class="contenedor">
    <div class="max-w-3xl">
      <p class="eyebrow revelar">Todo lo que hace</p>
      <h2 class="titulo-seccion mt-4 revelar" style="transition-delay: 70ms">
        Doce áreas, un solo sistema.
      </h2>
      <p class="bajada mt-5 revelar" style="transition-delay: 140ms">
        Un solo plan, así que todo esto entra. No hay módulos aparte ni versión recortada.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        areas.map((area, i) => (
          <div
            class="panel-hover revelar flex flex-col p-6"
            style={`transition-delay: ${Math.min(i, 5) * 50}ms`}
          >
            <Icon name={area.icono} class="h-6 w-6 text-naranja-500" />

            <h3 class="mt-4 text-lg font-semibold leading-tight text-white">{area.titulo}</h3>
            <p class="mt-1 text-sm text-slate-400">{area.resumen}</p>

            {/* Las funciones, en renglones cortos. El filete las separa del
                encabezado sin meter otro borde. Las viñetas van en gris y no
                en naranja: con doce tarjetas son casi sesenta puntos, y el
                naranja de esta página vale porque está racionado. El acento se
                queda en el ícono, que es donde tiene que caer el ojo. */}
            <div class="filete my-5" />
            <ul class="flex flex-col gap-2">
              {area.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-300">
                  <span class="mt-[0.45rem] h-1 w-1 shrink-0 rounded-full bg-white/25" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
