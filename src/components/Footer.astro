---
import { EMAIL_CONTACTO, WHATSAPP_LINK } from '../config'

const anio = new Date().getFullYear()

const secciones = [
  {
    titulo: 'Producto',
    enlaces: [
      { href: '#producto', texto: 'Qué hace' },
      { href: '#precio', texto: 'Precio' },
      { href: '#preguntas', texto: 'Preguntas' },
    ],
  },
  {
    titulo: 'Contacto',
    enlaces: [
      { href: `mailto:${EMAIL_CONTACTO}`, texto: EMAIL_CONTACTO },
      ...(WHATSAPP_LINK ? [{ href: WHATSAPP_LINK, texto: 'WhatsApp' }] : []),
      { href: '#solicitar', texto: 'Empezar ahora' },
    ],
  },
]
---

<footer class="border-t border-white/[0.08] bg-navy-900">
  <div class="contenedor py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <img src="/branding/fidcore-logo.svg" alt="FidCore" width="113" height="30" class="h-[30px] w-auto" />
        <p class="mt-4 max-w-xs text-sm text-slate-400">
          Sistema de gestión para Productores Asesores de Seguros. Hecho en Argentina.
        </p>
      </div>

      {
        secciones.map((seccion) => (
          <nav aria-label={seccion.titulo}>
            <p class="font-mono text-2xs uppercase tracking-[0.14em] text-slate-500">
              {seccion.titulo}
            </p>
            <ul class="mt-4 grid gap-2.5">
              {seccion.enlaces.map((e) => (
                <li>
                  <a href={e.href} class="text-sm text-slate-400 transition-colors hover:text-white">
                    {e.texto}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 border-t border-white/[0.06] pt-6">
      <p class="text-2xs text-slate-500">© {anio} FidCore. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
