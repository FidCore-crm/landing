---
import { Icon } from 'astro-icon/components'

/**
 * Las cuatro funciones principales después del importador, que desde la fase 2
 * (13/11/2026) tiene su propia sección animada (CargaIA.astro).
 *
 * Las de infraestructura (backups, actualizaciones) están en las tarjetas de
 * Funciones, en «Administración».
 */

const secundarias = [
  {
    icono: 'ph:bell-ringing',
    titulo: 'Renovaciones bajo control',
    texto:
      'Cada vencimiento con su fecha y su estado. La póliza renovada queda vinculada a la anterior y conserva el historial.',
  },
  {
    icono: 'ph:warning-octagon',
    titulo: 'Siniestros con trazabilidad',
    texto:
      'Cada caso con número interno, estados y registro de cada acción, con la información para el asegurado separada de la interna.',
  },
  {
    icono: 'ph:user-circle',
    titulo: 'Portal del asegurado',
    texto:
      'El asegurado consulta sus pólizas, descarga su documentación y denuncia un siniestro desde el teléfono, sin contraseña.',
  },
  {
    icono: 'ph:percent',
    titulo: 'Comisiones calculadas',
    texto:
      'Las reglas se configuran una vez por compañía y ramo. El sistema calcula las comisiones y permite controlar lo liquidado por cada compañía.',
  },
]

---

<section class="seccion">
  <div class="contenedor">
    <h2 class="titulo-seccion max-w-3xl revelar">Lo esencial de la gestión, en un solo lugar.</h2>

    <!-- La carga con IA tiene su propia sección (CargaIA): acá quedan las otras cuatro. -->
    <div class="mt-12 grid gap-4 md:grid-cols-2">

      {
        secundarias.map((f, i) => (
          <article
            class="panel-hover revelar flex flex-col p-6"
            style={`transition-delay: ${80 + i * 60}ms`}
          >
            <div class="flex items-start gap-3.5">
              <Icon name={f.icono} class="mt-0.5 h-5 w-5 shrink-0 text-naranja-500" />
              <div>
                <h3 class="font-display text-lg font-semibold text-white ancho-100">{f.titulo}</h3>
                <p class="mt-1.5 text-sm text-slate-400">{f.texto}</p>
              </div>
            </div>

            <!-- Una muestra chica de lo que hace, con datos de ejemplo. -->
            <div class="muestra mt-6" aria-hidden="true">
              {i === 0 && (
                <ul class="grid gap-1.5">
                  {[
                    ['Fernández, Lucía', 'Automotores', '3 días', 'text-red-300 bg-red-400/10'],
                    ['Gómez, Martín', 'Hogar', '12 días', 'text-amber-300 bg-amber-400/10'],
                    ['Ruiz, Carla', 'Comercio', '26 días', 'text-slate-300 bg-white/[0.06]'],
                  ].map(([quien, ramo, dias, color]) => (
                    <li class="flex items-center justify-between gap-3 rounded-control bg-navy-950/60 px-3 py-2">
                      <span class="text-xs text-slate-200">{quien} <span class="text-slate-500">· {ramo}</span></span>
                      <span class={`rounded-pill px-2 py-0.5 font-mono text-[10px] ${color}`}>{dias}</span>
                    </li>
                  ))}
                </ul>
              )}
              {i === 1 && (
                <ul class="grid gap-2 border-l border-white/10 pl-4">
                  {[
                    ['Inspección aprobada', 'Visible para el asegurado', 'text-emerald-300'],
                    ['Se pidió el presupuesto al taller', 'Interno', 'text-slate-400'],
                    ['Denuncia recibida desde el portal', 'Visible para el asegurado', 'text-emerald-300'],
                  ].map(([hecho, quien, color]) => (
                    <li class="relative">
                      <span class="absolute -left-[21px] top-1.5 h-2 w-2 rounded-full bg-naranja-500" />
                      <span class="block text-xs text-slate-200">{hecho}</span>
                      <span class={`block text-[10px] ${color}`}>{quien}</span>
                    </li>
                  ))}
                </ul>
              )}
              {i === 2 && (
                <div class="mx-auto max-w-[240px] rounded-[18px] border border-white/10 bg-navy-950/70 p-3">
                  <p class="text-[10px] uppercase tracking-wide text-slate-500">Mis pólizas</p>
                  {[
                    ['Automotores', 'VW Polo · AE 512 KD'],
                    ['Hogar', 'Castelar'],
                  ].map(([ramo, bien]) => (
                    <div class="mt-1.5 flex items-center justify-between rounded-lg bg-white/[0.05] px-2.5 py-1.5">
                      <span class="text-xs text-slate-200">{ramo}<span class="block text-[10px] text-slate-500">{bien}</span></span>
                      <span class="text-[10px] text-emerald-300">Vigente</span>
                    </div>
                  ))}
                  <span class="mt-2 block rounded-lg bg-naranja-500 py-1.5 text-center text-[11px] font-semibold text-white">Denunciar un siniestro</span>
                </div>
              )}
              {i === 3 && (
                <div class="rounded-control bg-navy-950/60 p-3">
                  <div class="flex items-baseline justify-between">
                    <span class="text-[10px] uppercase tracking-wide text-slate-500">Liquidación de octubre</span>
                    <span class="font-mono text-sm text-white">$ 412.800</span>
                  </div>
                  {[
                    ['Compañía A · Automotores', '18 %', '$ 236.500'],
                    ['Compañía B · Hogar', '22 %', '$ 98.300'],
                    ['Compañía C · Vida', '25 %', '$ 78.000'],
                  ].map(([quien, pct, monto]) => (
                    <div class="mt-1.5 flex items-center justify-between gap-2 text-[11px]">
                      <span class="text-slate-300">{quien}</span>
                      <span class="font-mono text-slate-500">{pct}</span>
                      <span class="font-mono text-slate-200">{monto}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
