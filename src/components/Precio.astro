---
import { Icon } from 'astro-icon/components'
import { PRECIO_TEXTO } from '../config'

const incluye = [
  'Clientes y pólizas sin límite',
  'Importador de pólizas con IA',
  'Comparador de renovaciones',
  'Siniestros con seguimiento y auditoría',
  'Portal del asegurado',
  'Cálculo de comisiones',
  'Backup diario de todo',
  'Actualizaciones y features nuevas',
  'Soporte directo, te atiendo yo',
  'Migración de tu cartera actual',
]
---

<section id="precio" class="seccion">
  <div class="contenedor">
    <div class="max-w-2xl">
      <p class="eyebrow revelar">Precio</p>
      <h2 class="titulo-seccion mt-4 revelar" style="transition-delay: 60ms">
        Un solo plan, con todo adentro.
      </h2>
      <p class="bajada mt-5 revelar" style="transition-delay: 120ms">
        No hay una versión recortada ni features escondidas detrás de un plan más caro.
      </p>
    </div>

    <div
      class="panel revelar mt-14 grid overflow-hidden lg:grid-cols-[minmax(0,400px)_1fr]"
      style="transition-delay: 180ms"
    >
      <!-- Precio -->
      <div
        class="grano relative p-8 lg:p-11"
        style="background-image: radial-gradient(120% 130% at 0% 0%, rgba(42,74,122,0.6) 0%, rgba(18,35,65,0.5) 50%, rgba(10,22,40,0) 100%)"
      >
        <p class="font-mono text-2xs uppercase tracking-[0.14em] text-slate-400">Plan único</p>
        <p class="mt-4 flex items-baseline gap-2">
          <span
            data-precio
            class="font-mono text-[46px] font-semibold leading-none text-white"
          >{PRECIO_TEXTO}</span>
          <span class="text-lg text-slate-400">por mes</span>
        </p>
        <p class="mt-2.5 text-sm text-slate-400">En pesos, IVA incluido.</p>

        <a href="#solicitar" class="btn-primario mt-8 w-full">
          Empezar ahora
          <Icon name="ph:arrow-right-bold" class="h-4 w-4" />
        </a>

        <p class="mt-4 text-sm text-slate-400">
          Cancelás cuando quieras, sin plazo mínimo y sin costo de baja.
        </p>
      </div>

      <!-- Lo que incluye, en dos columnas para no ser una lista larga y plana -->
      <div class="relative p-8 lg:p-11" style="box-shadow: inset 1px 0 0 rgba(255,255,255,0.07)">
        <p class="font-mono text-2xs uppercase tracking-[0.14em] text-slate-400">Incluye</p>
        <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            incluye.map((item) => (
              <li class="flex items-start gap-2.5">
                <Icon name="ph:check-bold" class="mt-1 h-3.5 w-3.5 shrink-0 text-naranja-500" />
                <span class="text-base text-slate-300">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
