---

<section id="funciones" class="seccion">
  <div class="contenedor">
    <div class="max-w-3xl">
      <p class="eyebrow revelar">Todo lo que hace</p>
      <h2 class="titulo-seccion mt-4 revelar" style="transition-delay: 70ms">
        El sistema completo, función por función.
      </h2>
      <p class="bajada mt-5 revelar" style="transition-delay: 140ms">
        Un solo plan, así que todo esto entra. No hay módulos aparte ni versión recortada.
      </p>
    </div>

    <div class="mt-16 flex flex-col gap-14 lg:gap-16">
      {
        bloques.map((bloque, i) => (
          <div class="revelar" style={`transition-delay: ${Math.min(i, 4) * 60}ms`}>
            {i > 0 && <div class="filete mb-14 lg:mb-16" />}

            <div class="grid gap-8 lg:grid-cols-[minmax(0,15rem)_1fr] lg:gap-14">
              {/* Rótulo del bloque. En pantalla grande queda fijo mientras se
                  recorren sus funciones: sin eso, a la mitad de la lista uno ya
                  no sabe de qué bloque está leyendo. */}
              <div class="lg:sticky lg:top-28 lg:self-start">
                <div class="flex items-baseline gap-3">
                  <span class="font-mono text-2xs text-naranja-500">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="titulo text-2xl leading-tight sm:text-[1.65rem]">{bloque.titulo}</h3>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-slate-500">{bloque.bajada}</p>
              </div>

              <div class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
                {bloque.funciones.map((f) => (
                  <div>
                    <h4 class="text-base font-semibold text-white">{f.nombre}</h4>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{f.texto}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
