---
const incluye = [
  'Clientes ilimitados',
  'Pólizas ilimitadas',
  'Siniestros con auditoría',
  'Importador IA de pólizas PDF',
  'Comparador IA de renovaciones',
  'Portal del asegurado',
  'Backups automáticos diarios',
  'Actualizaciones incluidas',
  'Soporte por WhatsApp',
  'Sin permanencia — cancelás cuando quieras',
]
---

<section id="precio" class="py-20 lg:py-28 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="text-2xs font-semibold uppercase tracking-wider text-fidcore-600 mb-3">
        Precio
      </div>
      <h2 class="text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight">
        Un solo plan. Todo incluido.
      </h2>
      <p class="text-lg text-slate-600 mt-4">
        Sin sorpresas ni features escondidas detrás de otro plan más caro.
      </p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
      <div class="bg-gradient-to-br from-navy-900 to-navy-800 p-8 text-center">
        <div class="text-white/70 text-sm font-medium uppercase tracking-wider">Plan único</div>
        <div class="mt-3 flex items-baseline justify-center gap-1">
          <span class="text-5xl lg:text-6xl font-bold text-white font-mono">$69.800</span>
          <span class="text-white/70 text-lg">/mes</span>
        </div>
        <div class="text-white/60 text-sm mt-2">ARS · IVA incluido</div>
      </div>

      <div class="p-8">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {incluye.map(item => (
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-sm text-slate-700">{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8 pt-6 border-t border-slate-100">
          <a
            href="#contacto"
            class="w-full inline-flex items-center justify-center gap-2 bg-navy-900 hover:bg-navy-800 text-white font-medium px-5 py-3.5 rounded-md transition-colors"
          >
            Empezar ahora
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <p class="text-2xs text-slate-500 text-center mt-3">
            Al hacer clic te dirigimos a Mercado Pago para la primera cuota.
            El CRM queda operativo dentro de las 48hs siguientes.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
